# LLM-generated insights in --agents mode (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AEO Writer write mode (optional)
ANTHROPIC_API_KEY=

# Medium publishing (optional)
MEDIUM_TOKEN=

# Multi-agent mesh — Cotal peer-to-peer (optional, --agents mode only)
COTAL_CREDS=
COTAL_NATS_URL=
